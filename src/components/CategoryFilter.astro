<!-- Static Shell -->
<div class="filter-container" id="filter-import">
  <button class="all-category" data-filter="*">All</button>
  <button class="web-category" data-filter="web">Web Development</button>
  <button class="experiments-category" data-filter="experiments"
    >Experiments</button
  >
</div>

<!-- Hydration Trigger -->
<script>
  const filterTrigger = document.getElementById("filter-import");

  filterTrigger?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const button = event.target.closest("[data-filter]");

    if (!button) return;

    const selectedCategory = button.getAttribute("data-filter");

    console.log(selectedCategory);
  });
</script>

