---
// For the assessment submission, I will submit a completed version of the portfolio page for the assignment. The islands that will be created are: a theme toggle and a category filter.

import "../css/global.css";
import Navigation from "../components/Navigation.astro";
import CategoryFilter from "../components/CategoryFilter.astro";
import projects from "../data/projects.json";
import Footer from "../components/Footer.astro";
---

<html>
  <head> </head>
  <body>
    <Navigation />
    <main class="projects-content">
      <h1>Projects & Experiments</h1>
      <p class="lead-text">
        These are some of my front-end development projects, marking the first
        stage of my technical journey. As I continue my studies, I plan to
        expand beyond web development into computer systems, networking, and
        other areas of technology.
      </p>
      <CategoryFilter />

      <div id="projects-grid" class="projects-grid">
        {
          projects.map((project) => (
            <article class="project-card" data-category={project.category}>
              <img
                src={project.thumbnail}
                alt={project.title}
                class="project-thumbnail"
              />
              <div class="project-info">
                <p class="project-category">{project.category}</p>
                <h2>{project.title}</h2>
                <p>{project.description}</p>
                <a href={`/projects/${project.slug}`} class="view-project">
                  View Project
                </a>

                <ul class="technology-tags" aria-label="Technologies">
                  {project.technologies.map((technology) => (
                    <li class="technology-tag">{technology}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
      <section class="more-work">
        <h2 class="text-center">More Work</h2>
        <p class="text-center">
          Smaller projects, experiments, and technical exercises. <a
            href="https://github.com/Hchewai"
            class="view-project text-center"
          >
            View more on GitHub
          </a>
        </p>

        {
          smallProjects.map((smallProject) => (
            <div
              class="small-card-wrapper"
              data-category={smallProject.category}
            >
              <p class="project-category">{smallProject.category}</p>
              <img
                src={smallProject.thumbnail}
                alt={smallProject.title}
                class="small-card-img"
              />
              <h3>{smallProject.title}</h3>
              <p>{smallProject.description}</p>
              <ul class="technology-tags" aria-label="Technologies">
                {smallProject.technologies.map((technology) => (
                  <li class="technology-tag"> {technology}</li>
                ))}
              </ul>
              <a href={`/projects/${smallProject.slug}`} class="view-project">
                View Project
              </a>
            </div>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
